# https://editorconfig.org  -- keep whitespace consistent across editors; the Python style itself is deliberately dense (see pyproject.toml)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,sh}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,html,css,js,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
