# so101 MLflow stack settings. Copy to infra/.env (gitignored) and change the two passwords.
# The AWS build (infra/terraform) uses the same names in lower case: MLFLOW_PORT -> var.mlflow_port, POSTGRES_DB -> var.postgres_db, ...

# MLflow: version pinned to the Mac venv (the clients must match the server's store schema); host port for the UI and the API
MLFLOW_VERSION=3.17.2
MLFLOW_PORT=5050

# Postgres backend store (experiments, runs, params, metrics, tags). On AWS this is the RDS instance.
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-postgres

# Artifact store: bucket name on the local S3-compatible store. On AWS the bucket name must be globally unique, e.g. so101-mlflow-<something>.
MLFLOW_ARTIFACT_BUCKET=mlflow

# Local S3-compatible store (RustFS) credentials and host ports: S3 API, and the browser console at http://127.0.0.1:9001
# Not used on AWS: there the ECS task role grants access to the bucket and no keys exist.
S3_ACCESS_KEY=so101
S3_SECRET_KEY=change-me-s3-secret
S3_PORT=9000
S3_CONSOLE_PORT=9001
