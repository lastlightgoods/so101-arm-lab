#!/usr/sbin/nft -f
# so101-hotspot.nft · what hotspot clients (10.101.0.0/24 on the Jetson's radio) may do: generated by hotspot.sh firewall.
# Apply:   sudo install -m 644 ~/so101/so101-hotspot.nft /etc/so101-hotspot.nft && sudo nft -f /etc/so101-hotspot.nft
# Remove:  sudo nft delete table inet so101_hotspot
# The dispatcher (90-so101-hotspot) applies /etc/so101-hotspot.nft when the hotspot comes up and deletes the table when it goes down.
# why its own table: NetworkManager's shared mode adds its own NAT/forward accepts for the subnet; a drop here still wins
# because every table's hook chain sees the packet and one drop is final. Non-hotspot traffic is untouched (policy accept,
# every rule is scoped to the radio interface).
table inet so101_hotspot {}
delete table inet so101_hotspot
table inet so101_hotspot {
    chain input {
        type filter hook input priority filter + 10; policy accept;
        iifname "wlP1p1s0" ct state established,related accept
        iifname "wlP1p1s0" udp dport { 67, 68 } accept                         # DHCP: a joining client has no address yet, so no saddr match here
        iifname "wlP1p1s0" ip saddr 10.101.0.0/24 udp dport 53 accept        # DNS (NetworkManager's dnsmasq)
        iifname "wlP1p1s0" ip saddr 10.101.0.0/24 tcp dport 53 accept
        iifname "wlP1p1s0" ip saddr 10.101.0.0/24 icmp type echo-request accept   # ping the gateway while debugging
        iifname "wlP1p1s0" meta nfproto ipv6 drop                             # ipv6 is disabled on the profile; no need to log the chatter
        iifname "wlP1p1s0" limit rate 6/minute log prefix "so101-hotspot drop in: "
        iifname "wlP1p1s0" drop                                               # includes the Jetson's own ssh (22): clients never log in here
    }
    chain forward {
        type filter hook forward priority filter + 10; policy accept;
        iifname "wlP1p1s0" oifname "enP8p1s0" ip saddr 10.101.0.0/24 tcp dport 8780 accept   # the pad gateway, nothing else (not the Mac's ssh)
        oifname "wlP1p1s0" ct state established,related accept
        iifname "wlP1p1s0" meta nfproto ipv6 drop
        iifname "wlP1p1s0" limit rate 6/minute log prefix "so101-hotspot drop fwd: "
        iifname "wlP1p1s0" drop
    }
}
